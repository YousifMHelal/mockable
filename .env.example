# Database — provide TWO URLs from your Postgres provider (Neon, Supabase, Vercel Postgres, etc.)
# The pooled URL is used by the app at runtime (prevents serverless connection exhaustion).
# The direct URL is used by Prisma migrations (DDL fails over a transaction-mode pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Vapi (voice AI) — only the public key is ever exposed to the browser
# Obtain both from https://dashboard.vapi.ai/
VAPI_PRIVATE_KEY=""                 # server-side only (NEVER expose to client)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=""      # safe to expose; used in browser SDK (Phase 4)

# LLM API key for interview scoring (server-side only)
LLM_API_KEY=""                      # Phase 5
